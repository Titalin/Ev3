# ===== Auth Server (puerto 9000) =====
AUTH_PORT=9000
AUTH_ISSUER=http://localhost:9000
FRONTEND_ORIGIN=http://localhost:4200
# Usuario admin en memoria (unico usuario del sistema)
ADMIN_USER=admin
ADMIN_PASSWORD=admin123
# Secreto del cliente confidencial postman-client (client_credentials de solo lectura)
POSTMAN_CLIENT_SECRET=postman-secret

# ===== Resource Servers / Gateway =====
# URL del Authorization Server que validan MS-A, MS-B y RATE
AUTH_SERVER_URL=http://localhost:9000
EUREKA_URL=http://localhost:8761/eureka/
RATE_PORT=8080
MSA_PORT=8081
MSB_PORT=8082
SHOW_SQL=false
